<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header bar with title and close / external buttons -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/lxpWebToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="Inscription LXP"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLxpWebOpenExternal"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_open_in_new"
                app:iconTint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Loading progress indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/lxpWebProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary" />

    <!-- Authenticated WebView -->
    <WebView
        android:id="@+id/lxpWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
