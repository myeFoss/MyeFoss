<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Category tag, XP badge & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogLxpCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:text="Pédagogie / Ateliers" />

        <!-- XP Badge -->
        <TextView
            android:id="@+id/dialogLxpXpBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_xp_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:visibility="gone"
            android:text="+10 XP" />

        <TextView
            android:id="@+id/dialogLxpStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/colorSecondaryContainer"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:text="Disponible" />

    </LinearLayout>

    <!-- Header with Title and Discrete Thumbnail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogLxpTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="19sp"
            android:text="Titre de l'action" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dialogLxpThumbnail"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    </LinearLayout>

    <!-- Action Description -->
    <TextView
        android:id="@+id/dialogLxpDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:text="Description complète de l'action ou formation..." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Metadata Section -->
    <!-- Date / Période -->
    <LinearLayout
        android:id="@+id/layoutDialogLxpDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/dialogLxpDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:text="Date non spécifiée" />

    </LinearLayout>

    <!-- Intervenant / Enseignant -->
    <LinearLayout
        android:id="@+id/layoutDialogLxpSpeaker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_school"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/dialogLxpSpeaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:text="Intervenant" />

    </LinearLayout>

    <!-- Lieu / Salle -->
    <LinearLayout
        android:id="@+id/layoutDialogLxpLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_location"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/dialogLxpLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:text="Salle / En ligne" />

    </LinearLayout>

    <!-- Participants / Capacité -->
    <LinearLayout
        android:id="@+id/layoutDialogLxpCapacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/dialogLxpCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:text="Places disponibles" />

    </LinearLayout>

    <!-- Boutons d'action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogLxpClose"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fermer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogLxpRegister"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="S'inscrire"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
