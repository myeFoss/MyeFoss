<resources>
    <!-- Base Material 3 Theme (Ocean Blue) -->
    <style name="Theme.MyeFoss" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Emerald Palette Theme -->
    <style name="Theme.MyeFoss.Emerald" parent="Theme.MyeFoss">
        <item name="colorPrimary">@color/emerald_light_primary</item>
        <item name="colorOnPrimary">@color/emerald_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/emerald_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/emerald_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/emerald_light_secondary</item>
        <item name="colorOnSecondary">@color/emerald_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/emerald_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/emerald_light_onSecondaryContainer</item>
        <item name="colorSurfaceVariant">@color/emerald_light_surfaceVariant</item>
    </style>

    <!-- Purple Palette Theme -->
    <style name="Theme.MyeFoss.Purple" parent="Theme.MyeFoss">
        <item name="colorPrimary">@color/purple_light_primary</item>
        <item name="colorOnPrimary">@color/purple_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/purple_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/purple_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/purple_light_secondary</item>
        <item name="colorOnSecondary">@color/purple_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/purple_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/purple_light_onSecondaryContainer</item>
        <item name="colorSurfaceVariant">@color/purple_light_surfaceVariant</item>
    </style>

    <!-- Amber Palette Theme -->
    <style name="Theme.MyeFoss.Amber" parent="Theme.MyeFoss">
        <item name="colorPrimary">@color/amber_light_primary</item>
        <item name="colorOnPrimary">@color/amber_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/amber_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/amber_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/amber_light_secondary</item>
        <item name="colorOnSecondary">@color/amber_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/amber_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/amber_light_onSecondaryContainer</item>
        <item name="colorSurfaceVariant">@color/amber_light_surfaceVariant</item>
    </style>
</resources>
